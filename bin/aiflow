#!/usr/bin/env bash
# AIFLOW v2 lightweight project-isolated entry point.

set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOL_ROOT="$(cd "$BIN_DIR/.." && pwd)"

# The package is installed once. This source-tree fallback keeps local and offline
# development deterministic without inheriting any AIFLOW_* project selector.
if [[ -d "$TOOL_ROOT/src/aiflow" ]]; then
  export PYTHONPATH="$TOOL_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
fi

exec python3 -m aiflow "$@"
